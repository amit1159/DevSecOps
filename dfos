pipeline {
    agent any

    parameters {
        string(
            name: 'QA_BASE_URL',
            defaultValue: 'https://qa.dfos.co/app',
            description: 'DFOS QA application URL'
        )
        choice(
            name: 'SBOM_GATE_SEVERITY',
            choices: ['CRITICAL', 'HIGH,CRITICAL'],
            description: 'SBOM security gate: severities that trip the gate'
        )
        choice(
            name: 'SBOM_GATE_MODE',
            choices: ['warn', 'block'],
            description: 'warn = build marked UNSTABLE, block = build marked FAILURE when the gate trips'
        )
    }

    environment {
        SCANNER_HOME = tool 'sonarscanner'
        REPORT_DIR = "/var/www/html/devsecops-reports/${BUILD_NUMBER}"
        ZAP_HOME = '/opt/zaproxy'
        ZAP_PORT = '8091'
        TRIVY_BIN = '/usr/bin/trivy'
        SYFT_BIN = '/usr/bin/syft'
        SBOM_NAME = 'dfos-qa-server'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
        timeout(time: 90, unit: 'MINUTES')
    }

    stages {

        // --------------------------------------------------
        // 1. GIT CHECKOUT
        // --------------------------------------------------
        stage('Git Checkout') {
            steps {
                git branch: 'main',
                    credentialsId: 'dfos',
                    url: 'https://github.com/nrvdesignxdfos/qa-server.git'
            }
        }

        // --------------------------------------------------
        // 2. PREPARE AND VALIDATE
        // --------------------------------------------------
        stage('Prepare Reports & Validate') {
            steps {
                sh '''
                    set -eu

                    mkdir -p "$REPORT_DIR"
                    test -d /var/www/html/devsecops-reports
                    test -w "$REPORT_DIR" || {
                        echo "Jenkins cannot write to $REPORT_DIR. Grant the Jenkins runtime user write access to /var/www/html/devsecops-reports."
                        exit 1
                    }

                    echo "Build: $BUILD_NUMBER" > "$REPORT_DIR/build-info.txt"
                    echo "Commit: $(git rev-parse HEAD)" >> "$REPORT_DIR/build-info.txt"
                    echo "QA URL: $QA_BASE_URL" >> "$REPORT_DIR/build-info.txt"

                    # Authorized QA target validation
                    case "$QA_BASE_URL" in
                        https://qa.dfos.co/app|https://qa.dfos.co/app/|http://qa.dfos.co/app|http://qa.dfos.co/app/)
                            ;;
                        *)
                            echo "Unauthorized QA target. Scan aborted."
                            exit 1
                            ;;
                    esac

                    # Verify installed tools
                    command -v gitleaks
                    command -v semgrep
                    semgrep --version
                    command -v python3
                    command -v ss
                    command -v "$TRIVY_BIN"
                    "$TRIVY_BIN" --version | head -n 1
                    command -v "$SYFT_BIN"
                    "$SYFT_BIN" version | head -n 1

                    test -x "$SCANNER_HOME/bin/sonar-scanner"
                    test -x "$ZAP_HOME/zap.sh"

                    # Check ZAP port
                    if ss -lnt | grep -q ":${ZAP_PORT} "; then
                        echo "ZAP port ${ZAP_PORT} is already in use."
                        exit 1
                    fi

                    echo "All required tools verified."
                    echo "ZAP port ${ZAP_PORT} is available."

                    # Generate ZAP Automation Framework plan (Traditional + Firefox Headless + Pen Test)
                    cat > "$REPORT_DIR/zap-plan.yaml" <<EOF
env:
  contexts:
    - name: DFOS-QA
      urls:
        - "$QA_BASE_URL"
      includePaths:
        - "${QA_BASE_URL}.*"

jobs:
  - type: spider
    parameters:
      context: DFOS-QA
      maxDuration: 10
      maxDepth: 5

  - type: spiderAjax
    parameters:
      context: DFOS-QA
      browserId: firefox-headless
      maxDuration: 10
      inScopeOnly: true

  - type: passiveScan-wait
    parameters:
      maxDuration: 5

  - type: activeScan
    parameters:
      context: DFOS-QA
      policy: "Pen Test"
      maxRuleDurationInMins: 5
      maxScanDurationInMins: 30

  - type: report
    parameters:
      template: traditional-json
      reportDir: "$REPORT_DIR"
      reportFile: zap-dast-report.json
      reportTitle: DFOS QA DAST Report
      reportDescription: DFOS QA Full Automated Pen Test Scan

  - type: report
    parameters:
      template: traditional-html
      reportDir: "$REPORT_DIR"
      reportFile: zap-dast-report.html
      reportTitle: DFOS QA DAST Report
      reportDescription: DFOS QA Full Automated Pen Test Scan
EOF

                    echo "ZAP Automation Framework plan generated in $REPORT_DIR."
                '''
            }
        }

        // --------------------------------------------------
        // 3. FULL PARALLEL SECURITY SCANNING
        // --------------------------------------------------
        stage('Parallel Security Scanning') {
            parallel {

                // 1. GITLEAKS
                stage('Gitleaks - Secret Scanning') {
                    steps {
                        sh '''
                            set +e

                            gitleaks detect \
                                --source . \
                                --report-format json \
                                --report-path "$REPORT_DIR/gitleaks-report.json" \
                                --redact \
                                --exit-code 0

                            if [ ! -f "$REPORT_DIR/gitleaks-report.json" ]; then
                                echo "Gitleaks report missing."
                                exit 2
                            fi

                            echo "Gitleaks scan complete. Output saved to $REPORT_DIR/gitleaks-report.json"
                        '''
                    }
                }

                // 2. SEMGREP SAST
                stage('Semgrep - SAST') {
                    steps {
                        sh '''
                            set +e

                            semgrep scan \\
                                --config p/php \\
                                --config p/phpcs-security-audit \\
                                --config p/security-audit \\
                                --config p/owasp-top-ten \\
                                --config p/cwe-top-25 \\
                                --config p/xss \\
                                --config p/command-injection \\
                                --config p/sql-injection \\
                                --config p/secrets \\
                                --config p/jwt \\
                                --config p/insecure-transport \\
                                --config p/javascript \\
                                --exclude vendor \\
                                --exclude node_modules \\
                                --exclude tests \\
                                --exclude assets \\
                                --exclude system \\
                                --exclude reports \\
                                --exclude 'application/third_party' \\
                                --exclude 'application/libraries/dompdf*' \\
                                --exclude 'semgrep.*' \\
                                --timeout 120 \\
                                --timeout-threshold 0 \\
                                --max-target-bytes 5000000 \\
                                --json-output="$REPORT_DIR/semgrep.json" \\
                                --text-output="$REPORT_DIR/semgrep.txt" \\
                                . || true

                            if [ ! -s "$REPORT_DIR/semgrep.json" ]; then
                                echo '{"results":[],"errors":[{"message":"Semgrep did not produce a JSON report; inspect Jenkins console log."}]}' > "$REPORT_DIR/semgrep.json"
                            fi
                            if [ ! -f "$REPORT_DIR/semgrep.txt" ]; then
                                echo "Semgrep text report was not generated." > "$REPORT_DIR/semgrep.txt"
                            fi
                            echo "Semgrep scan complete. Reports saved in $REPORT_DIR."
                        '''
                    }
                }

                // 3. SONARQUBE SAST
                stage('SonarQube - SAST') {
                    steps {
                        withCredentials([
                            string(
                                credentialsId: 'sonar',
                                variable: 'SONAR_TOKEN'
                            )
                        ]) {
                            sh '''
                                set +e

                                "$SCANNER_HOME/bin/sonar-scanner" \
                                    -Dsonar.projectKey=Dfos \
                                    -Dsonar.projectName="DF-OS" \
                                    -Dsonar.projectVersion=1.0 \
                                    -Dsonar.sources=. \
                                    -Dsonar.host.url=http://103.25.175.146 \
                                    -Dsonar.token="$SONAR_TOKEN" \
                                    -Dsonar.sourceEncoding=UTF-8 \
                                    -Dsonar.php.file.suffixes=.php \
                                    -Dsonar.qualitygate.wait=false \
                                    -Dsonar.exclusions="**/composer-setup.php,**/vendor/**,**/system/**,**/application/third_party/**,**/application/libraries/**,**/build/**,**/*_backup_*.php,**/*_old.php,**/node_modules/**,**/.git/**,**/sample_csv/**,**/assets/**,**/devsecops-reports/**" \
                                    > "$REPORT_DIR/sonarqube-report.txt" 2>&1

                                cat "$REPORT_DIR/sonarqube-report.txt"
                                echo "SonarQube analysis complete."
                            '''
                        }
                    }
                }

                // 4. OWASP ZAP DAST (Pen Test with Headless Spider)
                stage('OWASP ZAP - Web DAST') {
                    steps {
                        sh '''
                            set +e

                            "$ZAP_HOME/zap.sh" \
                                -cmd \
                                -port "$ZAP_PORT" \
                                -autorun "$REPORT_DIR/zap-plan.yaml" \
                                > "$REPORT_DIR/zap-console-report.txt" 2>&1

                            cat "$REPORT_DIR/zap-console-report.txt"
                            echo "OWASP ZAP scan complete."
                        '''
                    }
                }

                // 5. TRIVY FILESYSTEM SECURITY SCAN + TRIVY SBOM
                stage('Trivy - Filesystem Security Scan') {
                    steps {
                        sh '''
                            set +e

                            "$TRIVY_BIN" fs \
                                --scanners vuln,misconfig,secret \
                                --severity HIGH,CRITICAL \
                                --skip-dirs .git \
                                --skip-dirs vendor \
                                --skip-dirs node_modules \
                                --skip-dirs devsecops-reports \
                                --skip-dirs reports \
                                --timeout 15m \
                                --format json \
                                --output "$REPORT_DIR/trivy-report.json" \
                                .

                            # Also generate HTML report natively from Trivy
                            "$TRIVY_BIN" fs \
                                --scanners vuln,misconfig,secret \
                                --severity HIGH,CRITICAL \
                                --skip-dirs .git \
                                --skip-dirs vendor \
                                --skip-dirs node_modules \
                                --skip-dirs devsecops-reports \
                                --skip-dirs reports \
                                --timeout 15m \
                                --format template \
                                --template "@contrib/html.tpl" \
                                --output "$REPORT_DIR/trivy-native.html" \
                                . 2>/dev/null || true

                            # CycloneDX SBOM generated by Trivy (used by the SBOM security gate)
                            "$TRIVY_BIN" fs \
                                --format cyclonedx \
                                --skip-dirs .git \
                                --skip-dirs vendor \
                                --skip-dirs node_modules \
                                --skip-dirs devsecops-reports \
                                --skip-dirs reports \
                                --timeout 15m \
                                --output "$REPORT_DIR/trivy-sbom.cdx.json" \
                                .

                            echo "Trivy scan and Trivy SBOM complete."
                        '''
                    }
                }

                // 6. SYFT - SBOM GENERATION
                stage('Syft - SBOM Generation') {
                    steps {
                        sh '''
                            set +e

                            "$SYFT_BIN" dir:. \
                                --exclude ./.git \
                                --exclude ./vendor \
                                --exclude ./node_modules \
                                --exclude ./devsecops-reports \
                                --exclude ./reports \
                                --source-name "$SBOM_NAME" \
                                --source-version "$BUILD_NUMBER" \
                                -o cyclonedx-json="$REPORT_DIR/syft-sbom.cdx.json" \
                                -o table="$REPORT_DIR/syft-packages.txt"

                            echo "Syft SBOM complete."
                        '''
                    }
                }
            }
        }

        // --------------------------------------------------
        // 4. TRIVY - VULNERABILITY SCAN AGAINST BOTH SBOMs
        //    Runs after the parallel block so both SBOMs exist.
        // --------------------------------------------------
        stage('SBOM Vulnerability Scan') {
            steps {
                sh '''
                    set +e

                    for SRC in trivy syft; do
                        SBOM_FILE="$REPORT_DIR/${SRC}-sbom.cdx.json"
                        if [ ! -s "$SBOM_FILE" ]; then
                            echo "$SBOM_FILE missing or empty; skipping."
                            continue
                        fi

                        "$TRIVY_BIN" sbom \
                            --scanners vuln \
                            --format json \
                            --output "$REPORT_DIR/${SRC}-sbom-vulnerabilities.json" \
                            "$SBOM_FILE"
                        echo "Trivy scan of ${SRC} SBOM exit code: $?"

                        # Plain-text table from the same JSON (no second scan)
                        "$TRIVY_BIN" convert \
                            --format table \
                            --output "$REPORT_DIR/${SRC}-sbom-vulnerabilities.txt" \
                            "$REPORT_DIR/${SRC}-sbom-vulnerabilities.json"
                    done

                    # Findings are shown in the HTML reports; the gate stage decides pass/fail.
                    exit 0
                '''
            }
        }

        // --------------------------------------------------
        // 5. SBOM SECURITY GATE (Trivy SBOM)
        //    warn  -> build UNSTABLE when findings exist
        //    block -> build FAILURE when findings exist
        // --------------------------------------------------
        stage('SBOM Security Gate') {
            steps {
                script {
                    def gateResult = (params.SBOM_GATE_MODE == 'block') ? 'FAILURE' : 'UNSTABLE'
                    catchError(buildResult: gateResult, stageResult: gateResult) {
                        sh '''
                            set +e

                            GATE_SEV="${SBOM_GATE_SEVERITY:-CRITICAL}"
                            SBOM_FILE="$REPORT_DIR/trivy-sbom.cdx.json"
                            STATUS_FILE="$REPORT_DIR/sbom-gate-status.txt"

                            if [ ! -s "$SBOM_FILE" ]; then
                                echo "SKIPPED - Trivy SBOM was not generated" > "$STATUS_FILE"
                                echo "Gate skipped: $SBOM_FILE missing."
                                exit 0
                            fi

                            # Accepted risks can be listed by CVE ID in .trivyignore at the repo root.
                            "$TRIVY_BIN" sbom \
                                --scanners vuln \
                                --severity "$GATE_SEV" \
                                --exit-code 3 \
                                --format table \
                                --output "$REPORT_DIR/sbom-gate.txt" \
                                "$SBOM_FILE"
                            RC=$?

                            cat "$REPORT_DIR/sbom-gate.txt" 2>/dev/null

                            case "$RC" in
                                0) echo "PASSED - no $GATE_SEV vulnerabilities" > "$STATUS_FILE" ;;
                                3) echo "FAILED - $GATE_SEV vulnerabilities found" > "$STATUS_FILE" ;;
                                *) echo "ERROR - Trivy exited with code $RC" > "$STATUS_FILE" ;;
                            esac

                            cat "$STATUS_FILE"
                            exit $RC
                        '''
                    }
                }
            }
        }
    }

    // ------------------------------------------------------
    // 6. HTML REPORT GENERATION & DASHBOARD CREATION
    // ------------------------------------------------------
    post {
        always {
            script {
                sh '''
                    set +e

                    mkdir -p "$REPORT_DIR"

                    python3 - <<'PY'
import os
import json
import html
from pathlib import Path
from datetime import datetime, timezone

report_dir = Path(os.environ["REPORT_DIR"])
build_number = os.environ.get("BUILD_NUMBER", "N/A")

def read_json(filename):
    path = report_dir / filename
    if not path.exists():
        return None
    try:
        return json.loads(path.read_text(errors="replace"))
    except Exception:
        return None

def read_text(filename):
    path = report_dir / filename
    if not path.exists():
        return "Report not generated."
    return path.read_text(errors="replace")

def safe(value):
    return html.escape(str(value if value is not None else ""))

def write_html(filename, title, content):
    document = f"""<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{safe(title)}</title>
<style>
body {{ font-family: Arial, sans-serif; margin: 30px; background: #f3f5f9; color: #202938; }}
h1 {{ color: #172554; }}
table {{ border-collapse: collapse; width: 100%; background: white; }}
th, td {{ border: 1px solid #ddd; padding: 10px; text-align: left; }}
th {{ background: #172554; color: white; }}
pre {{ background: white; padding: 15px; overflow-x: auto; white-space: pre-wrap; }}
a {{ color: #1d4ed8; text-decoration: none; font-weight: bold; }}
.btn-back {{ display: inline-block; margin-bottom: 20px; padding: 8px 15px; background: #172554; color: white; border-radius: 5px; }}
</style>
</head>
<body>
<a href="index.html" class="btn-back">← Back to Security Dashboard</a>
{content}
</body>
</html>"""
    (report_dir / filename).write_text(document)

# --------------------------------------------------
# 1. SEMGREP HTML (interactive report)
# --------------------------------------------------
workspace = Path(os.environ.get("WORKSPACE", "."))
semgrep_data = read_json("semgrep.json")
if not isinstance(semgrep_data, dict):
    semgrep_data = {"results": [], "errors": [{"type": "Report error", "message": "semgrep.json missing or invalid"}]}

SG_SEV = {"ERROR": "high", "WARNING": "medium", "INFO": "low"}

def sg_list(v):
    return v if isinstance(v, list) else ([v] if v else [])

def sg_code(path, start, end):
    try:
        lines = (workspace / path).read_text(errors="replace").splitlines()
    except Exception:
        return ""
    end = min(end, start + 7)
    return chr(10).join(l.rstrip() for l in lines[start - 1:end])[:3000]

sg_rules, sg_findings, sg_errors = {}, [], []
for x in semgrep_data.get("results", []) or []:
    if not isinstance(x, dict):
        continue
    rid = x.get("check_id", "unknown")
    ex = x.get("extra", {}) or {}
    md = ex.get("metadata", {}) or {}
    sg_rules.setdefault(rid, dict(
        sev=SG_SEV.get(str(ex.get("severity", "")).upper(), "low"),
        msg=ex.get("message", ""),
        url=md.get("shortlink") or md.get("source", ""),
        cwe=[str(c).split(":")[0] for c in sg_list(md.get("cwe"))][:2],
        owasp=[str(o).split(" - ")[0] for o in sg_list(md.get("owasp")) if "2021" in str(o)][:1],
        conf=md.get("confidence", "")))
    p = x.get("path", "")
    s_line = (x.get("start") or {}).get("line", 0)
    e_line = (x.get("end") or {}).get("line", s_line)
    code = ex.get("lines", "")
    if not code or code == "requires login":
        code = sg_code(p, s_line, e_line)
    if "secrets" in rid or "private-key" in rid:
        code = "[secret value redacted from report]"
    sg_findings.append(dict(file=p, rule=rid, line=s_line, end=e_line, code=code,
                            area="app" if p.startswith("application/") else "other"))

for e in semgrep_data.get("errors", []) or []:
    if not isinstance(e, dict):
        continue
    t = e.get("type")
    t = t if isinstance(t, str) else (t[0] if t else "Error")
    msg = str(e.get("message", "") or "")
    path = e.get("path") or ""
    if not path and e.get("spans"):
        path = (e["spans"][0] or {}).get("file", "")
    if not path and "line " in msg:
        path = msg.split("line ", 1)[1].split(":", 1)[0].strip()
    rule = e.get("rule_id") or ""
    if not rule and "running " in msg:
        rule = msg.split("running ", 1)[1].split(" on", 1)[0]
    sg_errors.append(dict(type=t, path=path, rule=rule.split(".")[-1]))

sg_payload = dict(rules=sg_rules, findings=sg_findings, errors=sg_errors,
                  version=semgrep_data.get("version", ""),
                  scanned=len((semgrep_data.get("paths") or {}).get("scanned", [])))

SG_TEMPLATE = """<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>__TITLE__</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{color-scheme:light;
 --bg:#F5F7FA;--panel:#FFFFFF;--ink:#16233A;--muted:#5A6779;--line:#DCE2EA;--code:#F0F3F7;
 --high:#C0392B;--high-bg:#FBECEA;--med:#B86E00;--med-bg:#FFF3E0;--low:#5A6779;--low-bg:#EEF1F5;
 --accent:#1F5FBF;--focus:#1F5FBF}
@media (prefers-color-scheme:dark){:root{color-scheme:dark;
 --bg:#0F1722;--panel:#172131;--ink:#E4EAF2;--muted:#9AA8BA;--line:#2A3749;--code:#111A27;
 --high:#FF7A6B;--high-bg:#3A1E1E;--med:#FFB547;--med-bg:#36290F;--low:#A9B5C6;--low-bg:#222D3D;
 --accent:#7FB0FF;--focus:#7FB0FF}}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.55 "IBM Plex Sans",-apple-system,"Segoe UI",Roboto,sans-serif}
.wrap{max-width:1180px;margin:0 auto;padding:32px 20px 64px}
header h1{font-size:28px;line-height:1.2;margin:0 0 6px;font-weight:700;letter-spacing:-.01em}
header p{margin:0;color:var(--muted)}
