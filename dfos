                    f"<td>{safe(target)}</td>"
                    f"<td>{safe(details)}</td>"
                    "</tr>"
                )

if not trivy_rows:
    trivy_rows = '<tr><td colspan="4">No HIGH or CRITICAL issues found.</td></tr>'

trivy_content = f"""
