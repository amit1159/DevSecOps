vuln_by_purl, vuln_by_nv = {}, {}
for r in (syft_scan or []):
    if r["purl"]:
        bucket = vuln_by_purl.setdefault(r["purl"], {s: 0 for s in SEV_ORDER})
        bucket[r["sev"]] += 1
    bucket = vuln_by_nv.setdefault((r["pkg"], r["ver"]), {s: 0 for s in SEV_ORDER})
    bucket[r["sev"]] += 1

def license_names(comp):
    names = []
    for entry in comp.get("licenses", []) or []:
        if not isinstance(entry, dict):
            continue
        if entry.get("expression"):
            names.append(entry["expression"])
            continue
        lic = entry.get("license") or {}
        name = lic.get("id") or lic.get("name")
        if name:
            names.append(name)
    return list(dict.fromkeys(names))

def is_strong_copyleft(names):
    for name in names:
        upper = name.upper()
        if "GPL" in upper and not upper.startswith("LGPL"):
            return True
    return False

def ecosystem(comp):
    purl = comp.get("purl") or ""
    if purl.startswith("pkg:"):
        return purl[4:].split("/", 1)[0]
    return comp.get("type") or "unknown"

packages, file_entries = [], 0
for comp in syft_sbom.get("components", []) or []:
    if not isinstance(comp, dict):
        continue
    if comp.get("type") == "file":
        file_entries += 1
        continue
    name = comp.get("name", "")
    full_name = comp["group"] + "/" + name if comp.get("group") else name
    ver = comp.get("version", "")
    counts = (vuln_by_purl.get(comp.get("purl") or "")
              or vuln_by_nv.get((full_name, ver))
              or vuln_by_nv.get((name, ver))
              or {})
    lic = license_names(comp)
    packages.append(dict(
        name=full_name, ver=ver, eco=ecosystem(comp), lic=lic,
        copyleft=is_strong_copyleft(lic), purl=comp.get("purl") or "",
        v={s: counts.get(s, 0) for s in SEV_ORDER}))
packages.sort(key=lambda p: tuple(-p["v"][s] for s in SEV_ORDER) + (p["name"].lower(),))

ecosystems = {}
for p in packages:
    ecosystems[p["eco"]] = ecosystems.get(p["eco"], 0) + 1

