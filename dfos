trivy = read_json("trivy-report.json")
trivy_rows = ""
trivy_counts = {"Vulnerabilities": 0, "Misconfigurations": 0, "Secrets": 0}

if isinstance(trivy, dict):
    for result in trivy.get("Results", []) or []:
        target = result.get("Target", "Unknown")
        for key, finding_type in [
            ("Vulnerabilities", "Vulnerability"),
            ("Misconfigurations", "Misconfiguration"),
            ("Secrets", "Secret")
        ]:
            findings = result.get(key, []) or []
            trivy_counts[key] += len(findings)

            for item in findings:
                severity = item.get("Severity", "N/A")
                if key == "Vulnerabilities":
                    details = f"{item.get('VulnerabilityID', '')} - {item.get('PkgName', '')} {item.get('InstalledVersion', '')} (Fixed in: {item.get('FixedVersion') or 'No fix'})"
                elif key == "Secrets":
                    details = f"{item.get('RuleID', '')} at line {item.get('StartLine', '?')}"
                else:
                    details = item.get("Title") or item.get("ID") or finding_type

                trivy_rows += (
                    "<tr>"
                    f"<td>{safe(finding_type)}</td>"
