<script>
const DATA = __DATA__;
const R = DATA.rules, F = DATA.findings;
const short = id => id.split('.').pop();
const esc = s => s.replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const sevLabel = {high:'High',medium:'Medium',low:'Low'};
const app = F.filter(f => f.area==='app');
const cnt = (arr, fn) => arr.filter(fn).length;
const files = new Set(app.map(f=>f.file)).size;
const BK=/(_old(_ui)?|_backup_[0-9]+|_[0-9]{1,2}|_[0-9]{2}_[0-9]{2}_[0-9]{4}|_[0-9]{8}|Bk)[.]php$/;
document.getElementById('sub').textContent=`Semgrep ${DATA.version}. ${DATA.scanned.toLocaleString()} files scanned.`;
document.getElementById('gaps').innerHTML=DATA.errors.map(e=>`<div><span class="t">${esc(e.type)}</span><code>${esc(e.path)}</code><span class="r">${esc(e.rule)}</span></div>`).join('');
document.getElementById('totals').innerHTML = [
 [F.length.toLocaleString(), 'total findings'],
 [app.length, 'in your own code'],
 [files, 'of your files affected'],
 [cnt(app,f=>R[f.rule].sev==='high'), 'high severity in your code'],
 [cnt(F,f=>BK.test(f.file)), 'in backup or old copies']
].map(([n,l])=>`<div><b>${n}</b><span>${l}</span></div>`).join('');

const PRIO = [
 {k:'remove', f:f=>f.area==='other', lvl:'Critical', c:'var(--high)', t:'Files that should not be in the project',
  d:'Findings outside application/, such as installer scripts, old reports or helper packages. Remove what is not needed in the repo.'},
 {k:'secrets', f:f=>f.area==='app'&&f.rule.includes('secrets.'), lvl:'Critical', c:'var(--high)', t:'Secrets committed to the repo',
  d:'Firebase admin service account and a private key. Rotate them, then move them out of the web root.'},
 {k:'sql', f:f=>f.area==='app'&&f.rule.endsWith('tainted-sql-string'), lvl:'High', c:'var(--high)', t:'SQL injection',
  d:'Request values concatenated into SQL. Use CodeIgniter query bindings (? placeholders).'},
 {k:'exec', f:f=>/(exec-use|backticks-use|eval-detected)$/.test(f.rule)&&f.area==='app', lvl:'High', c:'var(--high)', t:'Shell command execution',
  d:'exec() calls and PHP backticks, which run text as a shell command. Check that no request input reaches them.'},
 {k:'xss', f:f=>f.area==='app'&&f.rule.endsWith('echoed-request'), lvl:'High', c:'var(--med)', t:'Cross-site scripting (XSS)',
  d:'Request input echoed into HTML. Wrap output with html_escape().'},
 {k:'path', f:f=>f.area==='app'&&f.rule.endsWith('tainted-filename'), lvl:'Medium', c:'var(--med)', t:'Path traversal',
  d:'Request input used in file paths. Apply basename() and an allow-list.'},
 {k:'crypto', f:f=>f.rule.endsWith('weak-crypto'), lvl:'Review', c:'var(--low)', t:'Weak hashing (md5 / sha1)',
  d:'Mostly cache keys and file names, which is fine. Replace only where used for passwords, tokens or signatures.'},
];
document.getElementById('prio').innerHTML = PRIO.map(p=>{
 const hits = F.filter(p.f); const nf = new Set(hits.map(f=>f.file)).size;
 return `<button data-p="${p.k}" style="--c:${p.c}"><span class="lvl">${p.lvl}</span>
 <span><h3>${p.t}</h3><p>${p.d}</p></span><span class="n">${hits.length}<small>${nf} file${nf===1?'':'s'}</small></span></button>`;
}).join('');

const ruleSel = document.getElementById('rule');
Object.keys(R).sort().forEach(r=>{const o=document.createElement('option');o.value=r;o.textContent=short(r);ruleSel.appendChild(o)});

let state = {area:'app', q:'', sev:'', rule:'', p:''};
function render(){
 const q = state.q.toLowerCase(); const pt = PRIO.find(p=>p.k===state.p);
 const list = F.filter(f => (state.area==='all'||f.area===state.area)
   && (!state.sev || R[f.rule].sev===state.sev)
   && (!state.rule || f.rule===state.rule)
   && (!pt || pt.f(f))
   && (!q || (f.file+' '+f.rule+' '+(f.code||'')).toLowerCase().includes(q)));
 const byFile = new Map();
 list.forEach(f=>{ if(!byFile.has(f.file)) byFile.set(f.file,[]); byFile.get(f.file).push(f); });
 const order={high:0,medium:1,low:2};
 const groups=[...byFile.entries()].sort((a,b)=>{
  const sa=Math.min(...a[1].map(f=>order[R[f.rule].sev])), sb=Math.min(...b[1].map(f=>order[R[f.rule].sev]));
  return sa-sb || b[1].length-a[1].length;});
 document.getElementById('count').textContent = `${list.length.toLocaleString()} findings in ${groups.length} files`;
 const open = groups.length <= 8;
 document.getElementById('list').innerHTML = groups.length ? groups.map(([file,fs])=>{
  const byRule = new Map(); fs.forEach(f=>{ if(!byRule.has(f.rule)) byRule.set(f.rule,[]); byRule.get(f.rule).push(f); });
  const top = fs.map(f=>R[f.rule].sev).sort((a,b)=>order[a]-order[b])[0];
  return `<details class="file"${open?' open':''}><summary><span class="path">${esc(file)}</span>
   ${BK.test(file)?'<span class="bk">backup copy</span>':''}
   <span class="pill p-${top}">${fs.length} · ${sevLabel[top]}</span></summary>
   ${[...byRule.entries()].map(([rid,hs])=>{const r=R[rid];return `<div class="rule">
    <h4><span class="pill p-${r.sev}">${sevLabel[r.sev]}</span><code>${esc(short(rid))}</code></h4>
    <p class="msg">${esc(r.msg)} ${r.url?`<a href="${esc(r.url)}" target="_blank" rel="noopener">Rule details</a>`:''}</p>
    <div class="meta">${[...r.cwe,...r.owasp,r.conf?('Confidence: '+r.conf.toLowerCase()):''].filter(Boolean).map(x=>`<span>${esc(x)}</span>`).join('')}</div>
    ${hs.sort((a,b)=>a.line-b.line).map(h=>h.code?`<div class="hit"><span class="ln">${h.line}</span><pre>${esc(h.code)}</pre></div>`:`<div class="lines"><span>${h.end>h.line?'Lines '+h.line+'–'+h.end:'Line '+h.line}</span></div>`).join('')}
   </div>`}).join('')}</details>`;
 }).join('') : '<div class="empty">No findings match these filters. Clear the search or switch the area to All.</div>';
}
document.getElementById('q').addEventListener('input',e=>{state.q=e.target.value;render()});
document.getElementById('sev').addEventListener('change',e=>{state.sev=e.target.value;render()});
ruleSel.addEventListener('change',e=>{state.rule=e.target.value;state.p='';render()});
document.querySelectorAll('.seg button').forEach(b=>b.addEventListener('click',()=>{
 state.area=b.dataset.area; document.querySelectorAll('.seg button').forEach(x=>x.setAttribute('aria-pressed',x===b)); render();}));
document.querySelectorAll('.prio button').forEach(b=>b.addEventListener('click',()=>{
 state.p = state.p===b.dataset.p ? '' : b.dataset.p; state.rule=''; ruleSel.value='';
 state.area='all'; document.querySelectorAll('.seg button').forEach(x=>x.setAttribute('aria-pressed',x.dataset.area==='all'));
 render(); document.querySelector('.bar').scrollIntoView({behavior:'smooth'});}));
render();
</script>
</body>
</html>
"""

sg_back = '<a class="back" href="index.html">&larr; Back to Security Dashboard</a>'
sg_page = (SG_TEMPLATE
           .replace("__TITLE__", safe("Semgrep SAST Report - Build #" + str(build_number)))
           .replace("__BACK__", sg_back)
