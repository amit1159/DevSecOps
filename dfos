# --------------------------------------------------
# 4. SBOM REPORTS: SYFT PACKAGES + SBOM VULNERABILITIES
# --------------------------------------------------
SEV_ORDER = ["CRITICAL", "HIGH", "MEDIUM", "LOW", "UNKNOWN"]

def vparts(value):
    text = str(value or "").strip().lstrip("vV")
    parts = []
    for piece in text.split("."):
        digits = ""
        for ch in piece:
            if ch.isdigit():
                digits += ch
            else:
                break
        parts.append(int(digits) if digits else 0)
    while len(parts) < 3:
        parts.append(0)
    return tuple(parts)

def pick_fix(installed, fixed):
    # Lowest fixed version newer than installed, preferring the same major version
    current = vparts(installed)
    options = [f.strip() for f in str(fixed or "").split(",") if f.strip()]
    newer = [f for f in options if vparts(f) > current]
    if not newer:
        return ""
    same_major = [f for f in newer if vparts(f)[0] == current[0]]
    return min(same_major or newer, key=vparts)

def load_trivy_scan(filename, source):
    data = read_json(filename)
    if not isinstance(data, dict):
        return None
    rows = []
    for result in data.get("Results", []) or []:
        for v in result.get("Vulnerabilities", []) or []:
            sev = str(v.get("Severity", "UNKNOWN")).upper()
            if sev not in SEV_ORDER:
                sev = "UNKNOWN"
            rows.append(dict(
                id=v.get("VulnerabilityID", ""),
                pkg=v.get("PkgName", ""),
                ver=v.get("InstalledVersion", ""),
                fix=v.get("FixedVersion") or "",
                sev=sev,
                title=v.get("Title") or str(v.get("Description") or "")[:160],
                url=v.get("PrimaryURL", ""),
                purl=(v.get("PkgIdentifier") or {}).get("PURL", ""),
                src=source))
    return rows

def embed(payload):
    return json.dumps(payload).replace("</", "<" + chr(92) + "/")

trivy_scan = load_trivy_scan("trivy-sbom-vulnerabilities.json", "trivy")
syft_scan = load_trivy_scan("syft-sbom-vulnerabilities.json", "syft")

merged = {}
for scan in (trivy_scan or [], syft_scan or []):
    for r in scan:
        key = (r["id"], r["pkg"], r["ver"])
        if key not in merged:
            merged[key] = dict(r, src=[])
        if r["src"] not in merged[key]["src"]:
            merged[key]["src"].append(r["src"])
all_vulns = sorted(merged.values(), key=lambda r: (SEV_ORDER.index(r["sev"]), r["pkg"], r["id"]))

if trivy_scan is not None:
    primary_src = "trivy"
elif syft_scan is not None:
    primary_src = "syft"
else:
    primary_src = ""
primary_vulns = [r for r in all_vulns if primary_src in r["src"]]
sev_counts = {s: sum(1 for r in primary_vulns if r["sev"] == s) for s in SEV_ORDER}

plan_map = {}
for r in primary_vulns:
    item = plan_map.setdefault((r["pkg"], r["ver"]), dict(
        pkg=r["pkg"], ver=r["ver"], target="", nofix=0, counts={s: 0 for s in SEV_ORDER}))
    item["counts"][r["sev"]] += 1
    fix = pick_fix(r["ver"], r["fix"])
    if not fix:
        item["nofix"] += 1
    elif not item["target"] or vparts(fix) > vparts(item["target"]):
        item["target"] = fix
for item in plan_map.values():
    item["major"] = bool(item["target"]) and vparts(item["target"])[0] != vparts(item["ver"])[0]
upgrade_plan = sorted(plan_map.values(),
                      key=lambda p: tuple(-p["counts"][s] for s in SEV_ORDER) + (p["pkg"],))

compare = dict(
    both=sum(1 for r in all_vulns if len(r["src"]) == 2),
    trivy=sum(1 for r in all_vulns if r["src"] == ["trivy"]),
    syft=sum(1 for r in all_vulns if r["src"] == ["syft"]))

gate_file = report_dir / "sbom-gate-status.txt"
gate_status = gate_file.read_text(errors="replace").strip() if gate_file.exists() else "NOT RUN - gate stage did not complete"

sbom_downloads = [f for f in [
